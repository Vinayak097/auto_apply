{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "rootDir": "./wellfound",
    "outDir": "dist/wellfound",
    "strict": false,
    "declaration": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "types": ["node"],
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
  
  },
  
    "include": ["wellfound/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
